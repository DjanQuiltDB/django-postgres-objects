# The sdist is what downstream packagers build and test from, so it carries the whole test project and the docs, not
# just the importable package. Without this, setuptools' defaults ship tests/test_*.py but none of the fixture apps or
# settings they import, and the suite in the sdist cannot run.

include CHANGELOG.rst
include LICENSE
include README.rst

recursive-include src/postgres_objects py.typed

graft docs
graft tests

# docs/conf.py points html_logo and html_favicon at ../assets, so a docs build from the sdist fails without these -- and
# .readthedocs.yaml sets fail_on_warning, which turns a missing logo into a build failure rather than a shrug.
graft assets

prune docs/_build
global-exclude *.py[cod]
global-exclude __pycache__
